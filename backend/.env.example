# Copy this file to backend/.env and adjust values.
# Everything here is read by app/core/config.py (class Settings).

# ---- General ---------------------------------------------------------
APP_NAME=WLAN AttackLab
# "demonstration" uses labeled fixture results and never touches real tools.
# "real" requires aircrack-ng / tshark / capinfos / msfconsole to be installed
# and a lab target configured below.
EXECUTION_MODE=demonstration
DATABASE_URL=sqlite:///./data/attacklab.db

# ---- Networking / access control --------------------------------------
BIND_HOST=127.0.0.1
BIND_PORT=8000
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Only enforced if the backend is reachable from somewhere other than
# loopback (e.g. bound to the Kali host-only IP so Windows can reach it).
REQUIRE_ACCESS_TOKEN=false
ACCESS_TOKEN=

# ---- Uploads / limits ----------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=180

# ---- Wireless module -------------------------------------------------------
WORDLIST_DIR=./fixtures/wordlists
CAPTURE_FIXTURE_DIR=./fixtures/captures
AIRCRACK_NG_PATH=aircrack-ng
TSHARK_PATH=tshark
CAPINFOS_PATH=capinfos

# ---- Metasploit module -------------------------------------------------------
MSFCONSOLE_PATH=msfconsole
# Set this to your Metasploitable2 VM's host-only IP, e.g. 192.168.56.20
LAB_TARGET_HOST=
LAB_TARGET_ALLOWED_CIDR=192.168.56.0/24
LAB_TARGET_SERVICE_PORT=21

# ---- Reports -------------------------------------------------------------
REPORTS_DIR=./data/reports
